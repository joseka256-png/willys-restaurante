rules_version = '2';

// =========================================================
//  Reglas de seguridad — Tarjeta Willy's
//  Pegar en: Firebase → Firestore Database → Reglas → Publicar
//
//  · Cualquiera puede CREAR su tarjeta (siempre empieza en 0 sellos)
//    y CONSULTAR una tarjeta si conoce el teléfono exacto.
//  · Solo el PERSONAL (usuarios con documento en /staff/{uid})
//    puede sumar sellos, canjear premios, ver historial y listar clientes.
//  · Nadie puede ponerse sellos a sí mismo desde el navegador.
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function esStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Meta de sellos: mantener igual que LEALTAD.meta en firebase-config.js
    function META() { return 10; }

    // ---------- Personal ----------
    // Los documentos /staff/{uid} se crean a mano en la consola.
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---------- Tarjetas (id del documento = teléfono de 8 dígitos) ----------
    match /tarjetas/{tel} {
      allow get: if true;              // consultar sabiendo el teléfono
      allow list: if esStaff();        // buscar / reportes: solo personal

      // Registro del cliente: siempre en 0 sellos
      allow create: if tel.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['nombre','telefono','sellos','canjes','creada','actualizada'])
        && request.resource.data.telefono == tel
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.sellos == 0
        && request.resource.data.canjes == 0
        && request.resource.data.creada == request.time
        && request.resource.data.actualizada == request.time;

      // Sumar sellos o canjear premio: solo personal
      allow update: if esStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellos','canjes','actualizada','nombre'])
        && request.resource.data.telefono == resource.data.telefono
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3
        && request.resource.data.actualizada == request.time
        && (
          // sumar sellos (1 o más, sin pasar la meta)
          ( request.resource.data.sellos > resource.data.sellos
            && request.resource.data.sellos <= META()
            && request.resource.data.canjes == resource.data.canjes )
          ||
          // canjear premio (tarjeta llena → vuelve a 0)
          ( resource.data.sellos == META()
            && request.resource.data.sellos == 0
            && request.resource.data.canjes == resource.data.canjes + 1 )
          ||
          // solo corregir el nombre
          ( request.resource.data.sellos == resource.data.sellos
            && request.resource.data.canjes == resource.data.canjes )
        );

      allow delete: if false;

      // Historial de movimientos: solo personal, y no se puede alterar
      match /movimientos/{mov} {
        allow read: if esStaff();
        allow create: if esStaff()
          && request.resource.data.tipo in ['sello','sin_sello','canje']
          && request.resource.data.staffUid == request.auth.uid
          && request.resource.data.fecha == request.time;
        allow update, delete: if false;
      }
    }

    // Todo lo demás: cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
